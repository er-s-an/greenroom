{
  "name": "greenroom",
  "version": "0.1.0",
  "description": "The AI copilot for community and hackathon organizers — with gates. Every answer needs a citation, every outreach needs an approval, every action leaves a trail.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:web": "vite dev web",
    "build": "vite build web",
    "build:web": "vite build web",
    "start": "tsx src/server/index.ts",
    "sim": "tsx src/sim/cli.ts",
    "sim:radar": "tsx src/sim/radar-cli.ts",
    "sim:report": "tsx src/sim/report-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "e2e": "tsx scripts/e2e.mts",
    "eval:live": "tsx scripts/eval-live.mts"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "discord.js": "^14.27.0",
    "fastify": "^5.12.3",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
